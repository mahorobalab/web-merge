#!/bin/sh
# Prevent accidental direct commits to main branch
branch="$(git symbolic-ref --short HEAD 2>/dev/null)"

if [ "$branch" = "main" ]; then
  echo ""
  echo "================================================================"
  echo " ❌ [WebMerge Guard] 'main' ブランチへの直接コミットは禁止されています！"
  echo "    Direct commits to 'main' are prohibited."
  echo "----------------------------------------------------------------"
  echo " 👉 'development' または 'feature/xxx' ブランチで作業してください。"
  echo "    例: git checkout development"
  echo "================================================================"
  echo ""
  exit 1
fi
