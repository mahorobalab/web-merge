#!/bin/sh
# Prevent accidental merges into main branch locally
branch="$(git symbolic-ref --short HEAD 2>/dev/null)"

if [ "$branch" = "main" ]; then
  echo ""
  echo "================================================================"
  echo " ❌ [WebMerge Guard] ローカルでの 'main' へのマージは禁止されています！"
  echo "    Merging into 'main' locally is prohibited."
  echo "----------------------------------------------------------------"
  echo " 👉 main への反映は GitHub の Pull Request 経由で行ってください。"
  echo "================================================================"
  echo ""
  exit 1
fi
